{
  "manifest_version": 3,
  "name": "Human Typer - Background Mode",
  "version": "0.5.1",
  "description": "Automatically type at a human pace in Google Docs, Word Online, and any website in the background.",
  "permissions": ["activeTab", "scripting", "storage", "notifications"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Human Typer"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "humantyper@desktop.app",
      "strict_min_version": "109.0"
    }
  }
}
